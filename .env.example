# Copy to .env and adjust
ANDEAN_DATA_DIR=data
ANDEAN_SQLITE_PATH=data/andean_potato.sqlite3
# Optional: comma-separated CSV URLs (MIDAGRI open data / manual exports)
ANDEAN_EXTRA_CSV_URLS=
# Try live SISAP HTML fetch (best-effort; may fail outside Peru / if portal changes)
ANDEAN_FETCH_SISAP_HTML=0
# Optional Prophet (heavy); app uses statsmodels baseline by default
ANDEAN_USE_PROPHET=0
